{
    "PageLayout": {
        "PageSize": "A4",
        "TopMargin": 72,
        "BottomMargin": 72,
        "LeftMargin": 72,
        "RightMargin": 72,
        "LogoPath": "./allure-config/mycompanylogo.png",
        "LogoLocation": {"Vertical": "Top", "Horizontal": "Left"},
        "SignatureBoxLocation":  {"Vertical": "Top", "Horizontal": "Right"},
        "UseExecutorAsTitle": false,
        "NewPagePerScenario": true,
        "SortFeaturesByRunOrder": true,
        "DisplayTextAttachment": true
    },
    "TextFormat": {
        "TitleFont": "Helvetica",
        "TitleSize": 22,
        "TitleFormatOptions": {"Bold": false, "Italic": false, "Underline": false, "Color": "darkblue"},
        "HeadingFont": "Helvetica",
        "HeadingSize": 14,
        "HeadingFormatOptions": {"Bold": false, "Italic": false, "Underline": false, "Color": "darkblue"},
        "EntryFont": "Helvetica",
        "EntrySize": 8,
        "EntryFormatOptions": {"Bold": false, "Italic": false, "Underline": false, "Color": "black"},
        "FeatureFont": "Helvetica",
        "FeatureSize": 12,
        "FeatureFormatOptions": {"Bold": false, "Italic": false, "Underline": false, "Color": "darkblue"},
        "ScenarioFont": "Helvetica",
        "ScenarioSize": 10,
        "ScenarioFormatOptions": {"Bold": false, "Italic": false, "Underline": false, "Color": "blue"},
        "ScenarioParametersFont": "Helvetica",
        "ScenarioParametersSize": 8,
        "ScenarioParametersFormatOptions": {"Bold": false, "Italic": false, "Underline": false, "Color": "grey"},
        "StepFont": "Helvetica",
        "StepSize": 7,
        "StepFormatOptions": {"Bold": false, "Italic": false, "Underline": false, "Color": "black"},
        "ErrorFont": "Helvetica",
        "ErrorSize": 8,
        "ErrorFormatOptions": {"Bold": false, "Italic": false, "Underline": false, "Color": "darkred"},
        "TextAttachmentFont": "Helvetica",
        "TextAttachmentSize": 7,
        "TextAttachmentFormatOptions": {"Bold": false, "Italic": false, "Underline": false, "Color": "black"}
